#!/usr/bin/env bash
# TechieFlow telemetry — post-commit hook TEMPLATE.
# Installed into <app>/.git/hooks/post-commit by .tfcore/telemetry/install-metrics.sh.
#
# This fires inside the OWNER's own `git commit`. No agent is involved, and no
# agent may install, edit, or trigger it — agents never run git (see
# .tfcore/hooks/block-git.sh). This is the only automated path that touches git,
# and it only READS commits that have already happened.
#
# IT RECONCILES, IT DOES NOT JUST APPEND.
#
#   The obvious hook writes one record for the commit that just happened. That
#   loses data in exactly the situation this portfolio lives in — the same repo
#   worked on from a Mac and from Windows/WSL:
#
#     * post-commit fires AFTER the commit is sealed, so its record lands in the
#       NEXT commit. The newest record is therefore always uncommitted, and if
#       you stop working on that machine it is never pushed at all.
#     * .git/hooks is not part of the repository, so a clone that has not been
#       refreshed has no hook and records nothing, silently.
#     * Anything committed on the other machine while this one was idle has no
#       record here either.
#
#   So instead of appending one line, this walks `git log` and appends a record
#   for EVERY commit reachable from HEAD that is not already in commits.jsonl.
#   git log is itself an append-only log and push/pull already replicates it to
#   every machine, so after a pull, one commit here backfills everything the
#   other machine did. Gaps close themselves; nothing has to be collected by hand.
#
#   Still owner-driven, still no agent, still nothing added to the commit being
#   made: this reads history and writes a file, exactly as before.
#
# Never stores the commit subject — only its conventional-commit prefix, if any.
# Subjects leak project detail. Exits 0 unconditionally: a commit must never fail
# because of telemetry.

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[[ -n "$ROOT" ]] || exit 0
EMIT="$ROOT/.tfcore/utils/tf-emit.sh"
[[ -f "$EMIT" ]] || exit 0

# --- preferred path: reconcile the whole window in one pass ----------------
# --quiet keeps `git commit` output clean and stops any git failure from being
# fatal; --limit bounds the log walk so a repo with a decade of history does not
# make the hook noticeable. Everything inside the window that is missing is
# written; everything already recorded is skipped on sha.
METRICS="$ROOT/.tfcore/telemetry/tf-metrics.sh"
LIMIT="${TF_COMMIT_RECONCILE_LIMIT:-500}"
if [[ -f "$METRICS" ]] && command -v python3 >/dev/null 2>&1; then
  bash "$METRICS" --backfill-commits "$ROOT" --limit "$LIMIT" --quiet >/dev/null 2>&1 && exit 0
fi

# --- fallback: one record for this commit, in pure bash --------------------
# Reached only when python3 is absent (tf-metrics.sh needs it). Records the
# commit that just happened and nothing else — the pre-2026-08-11 behaviour.
SHA="$(git rev-parse --short HEAD 2>/dev/null)"          || exit 0
BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"  || BRANCH="detached"
WHEN="$(TZ=UTC0 git log -1 --date=format-local:%Y-%m-%dT%H:%M:%SZ --format=%cd 2>/dev/null)"
SUBJ="$(git log -1 --format=%s 2>/dev/null)"
STAT="$(git show --shortstat --format= HEAD 2>/dev/null | tail -1)"

# Already recorded (a reconcile ran and then python3 vanished)? Do not duplicate.
if [[ -n "$SHA" ]] && grep -q "\"sha\":\"$SHA\"" "$ROOT/docs/metrics/commits.jsonl" 2>/dev/null; then
  exit 0
fi

# Conventional-commit prefix ONLY — the rest of the subject is discarded right here
# and never leaves this script. Matches the first token when it is one of the seven.
PREFIX="$(printf '%s' "$SUBJ" | sed -n 's/^\(feat\|fix\|docs\|chore\|refactor\|test\|build\)\([(!: ].*\)\?$/\1/p' | head -1)"

FILES="$(printf '%s' "$STAT"  | grep -oE '[0-9]+ files? changed'  | grep -oE '^[0-9]+')"
INS="$(printf '%s'   "$STAT"  | grep -oE '[0-9]+ insertions?'     | grep -oE '^[0-9]+')"
DEL="$(printf '%s'   "$STAT"  | grep -oE '[0-9]+ deletions?'      | grep -oE '^[0-9]+')"
: "${FILES:=0}" "${INS:=0}" "${DEL:=0}"

if [[ -n "$PREFIX" ]]; then PJ="\"$PREFIX\""; else PJ="null"; fi
TS_FIELD=""
[[ -n "$WHEN" ]] && TS_FIELD="\"ts\":\"$WHEN\","

printf '{%s"kind":"commit","sha":"%s","files":%s,"insertions":%s,"deletions":%s,"subject_prefix":%s,"branch":"%s"}\n' \
  "$TS_FIELD" "$SHA" "$FILES" "$INS" "$DEL" "$PJ" "$BRANCH" \
  | TF_METRICS_ROOT="$ROOT" bash "$EMIT" commits >/dev/null 2>&1

exit 0
