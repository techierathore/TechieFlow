# TechieFlow FRAMEWORK repo — NOTE: unlike consumer apps, .tfcore/, the
# .claude/ + .opencode/ harness mirrors, WORKFLOW.html and opencode.jsonc are
# the framework's SOURCE OF TRUTH here (scaffold-*.sh / update-framework.sh
# rsync FROM this repo into apps), so they stay TRACKED in this repo.
# Consumer apps get the opposite policy — their .gitignore framework block
# (.tfcore/, .claude/, .opencode/, /CLAUDE.md, /WORKFLOW.html, …) is managed
# automatically by the scaffold/update scripts.

# Per-machine / local-only — never commit
.claude/settings.local.json
tests/.artifacts/
.opencode/session/
.tfcore/.session/
*.bak
tmpclaude-*
**/tmpclaude-*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# TechieFlow framework — deployed copies, never commit (managed by scaffold/update-framework.sh)
.tfcore/
.claude/
.opencode/
.codex/
.agents/skills/
/CLAUDE.md
/WORKFLOW.html
/opencode.jsonc
/.tf-scaffold-note.txt

# TechieFlow agent artifacts — machine-generated test harness & logs, never commit (managed by scaffold/update-framework.sh)
node_modules/
/package.json
/package-lock.json
test-results/
test-results-*/
/scripts-*/
playwright-report/
.verify/
logs/
/docs/.last-verify.json
