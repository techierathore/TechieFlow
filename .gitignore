# TechieFlow FRAMEWORK repo.
# .tfcore/, .claude/, .opencode/, opencode.jsonc and package.json are this
# repo's SOURCE OF TRUTH and are tracked here (scaffold-*.sh / update-framework.sh
# rsync FROM this repo into apps). Consumer apps ignore those paths; the
# framework repo must not — ignoring them here silently drops every NEW
# framework file from commits.

# Per-machine / local-only — never commit
.claude/settings.local.json
.tf-scaffold-note.txt
.tfcore/.session/
.opencode/session/
# generated by scripts/install.mjs from the root opencode.jsonc, not source
.opencode/opencode.jsonc
__pycache__/
*.pyc
tests/.artifacts/
.verify/
logs/
docs/.last-verify.json
node_modules/
test-results/
test-results-*/
playwright-report/
*.bak
tmpclaude-*
**/tmpclaude-*

# OS junk
.DS_Store
Thumbs.db
desktop.ini
